# 우리가족챙기기 (Family Care) 환경 설정
PORT=8000
ENV=production
TZ=Asia/Seoul

# 공공데이터포털(data.go.kr) 일반 인증키 (신청 후 입력)
DATA_GO_KR_API_KEY=

# 카카오 개발자 REST API 키 (장소/식당 검색용)
KAKAO_REST_API_KEY=
# 카카오 개발자 JavaScript 키 (지도 SDK 렌더링용)
KAKAO_JS_API_KEY=

# 기본 위치 설정 (남양주시 평내동 평내마젤란21아파트 정밀 실측 좌표)
DEFAULT_LAT=37.643421
DEFAULT_LON=127.236018
DEFAULT_ADDRESS=경기도 남양주시 평내로 89 (평내동, 평내마젤란21아파트)

# 데이터베이스 경로
DB_PATH=/app/data/family_care.db
