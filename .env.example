# 우리가족챙기기 (Family Care) 환경 설정
PORT=8000
ENV=production
TZ=Asia/Seoul

# 공공데이터포털(data.go.kr) 일반 인증키 (신청 후 입력)
DATA_GO_KR_API_KEY=

# 카카오 개발자 REST API 키 (장소/식당 검색용)
KAKAO_REST_API_KEY=

# 기본 위치 설정 (남양주시 평내동 평내유진마젤란)
DEFAULT_LAT=37.6434558
DEFAULT_LON=127.2311716
DEFAULT_ADDRESS=경기도 남양주시 평내동 평내유진마젤란

# 데이터베이스 경로
DB_PATH=/app/data/family_care.db
